# ============================================
# Front-end Environment Variables
# ============================================
# Copy file này thành .env.local và điền thông tin của bạn
# Hoặc đổi tên file này thành .env.local

# ============================================
# API Configuration
# ============================================

# URL của Backend API (BẮT BUỘC trong production)
# Trong development: http://localhost:5000 hoặc http://127.0.0.1:5000
# Trong production: https://your-backend-domain.com
# Lưu ý: Phải có protocol (http:// hoặc https://), không có dấu / ở cuối
NEXT_PUBLIC_API_URL=http://localhost:5000

# Fallback API URL cho server-side rendering (tùy chọn)
# Chỉ dùng khi NEXT_PUBLIC_API_URL không hoạt động trong SSR
# API_URL=http://127.0.0.1:5000

# ============================================
# Site Configuration
# ============================================

# URL của website (dùng cho metadata, Open Graph, etc.)
# Trong development: http://localhost:3000
# Trong production: https://your-domain.com
# Lưu ý: Phải có protocol (http:// hoặc https://), không có dấu / ở cuối
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Environment
# ============================================

# Môi trường chạy ứng dụng (tự động set bởi Next.js)
# Development: NODE_ENV=development (mặc định khi chạy npm run dev)
# Production: NODE_ENV=production (mặc định khi chạy npm run build)
# Không cần set thủ công, Next.js sẽ tự động set
# NODE_ENV=development

# ============================================
# Notes
# ============================================
# 
# 1. NEXT_PUBLIC_* variables:
#    - Có thể truy cập từ cả client-side và server-side
#    - Được expose ra browser, không nên chứa thông tin nhạy cảm
#    - Phải rebuild sau khi thay đổi
#
# 2. Variables không có NEXT_PUBLIC_:
#    - Chỉ có thể truy cập từ server-side
#    - An toàn hơn cho thông tin nhạy cảm
#
# 3. File .env.local:
#    - Được gitignore, không commit lên repository
#    - Override các biến trong .env
#    - Dùng cho cấu hình local development
#
# 4. Production (Vercel):
#    - Set environment variables trong Vercel Dashboard
#    - Settings > Environment Variables
#    - Sau khi set, phải redeploy để áp dụng
#
# ============================================

